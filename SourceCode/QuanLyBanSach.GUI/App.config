<?xml version="1.0" encoding="utf-8" ?>
<configuration>
 
  <connectionStrings>
    <add name="QuanLyBanSachDB"
         connectionString="Server=.\SQLEXPRESS;Database=QuanLyBanSachDB;Trusted_Connection=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <!-- Thông tin cửa hàng in ở đầu hóa đơn và báo cáo cuối ngày -->
  <appSettings>
    <add key="TenCuaHang" value="NHÀ SÁCH SPT" />
    <add key="DiaChiCuaHang" value="280 An Dương Vương, Phường Chợ Quán, Quận 5, TP.HCM" />
    <add key="SDTCuaHang" value="028 3838 6868" />

    <!-- MÃ QR TRÊN HÓA ĐƠN (luôn mang số tiền TỔNG THANH TOÁN)
         - Để trống 2 dòng dưới: QR chứa chữ (tên nhà sách, mã HĐ, tổng tiền) – camera điện thoại quét đọc được.
         - Điền mã BIN ngân hàng + số tài khoản THẬT: QR thành VietQR, app ngân hàng quét tự điền số tiền.
           Một số mã BIN: Vietcombank 970436, VietinBank 970415, BIDV 970418, Agribank 970405,
           Techcombank 970407, MB 970422, ACB 970416, Sacombank 970403, TPBank 970423. -->
    <add key="QR_MaNganHang" value="970405" />
    <add key="QR_SoTaiKhoan" value="6607205199458" />
  </appSettings>

</configuration>
